{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chasehendrick/undeciphered-texts/schemas/cipher-case.schema.json",
  "title": "Unsolved cipher case",
  "description": "Authoring contract. Runtime validation also checks immutable source and intake hashes, UTF-8 bytes, UTC timestamps, URL authority, and safe local paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "status",
    "stage",
    "provenance",
    "source",
    "language",
    "alphabet",
    "transcription",
    "cribs",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "$ref": "#/$defs/nonempty"
    },
    "status": {
      "const": "unsolved"
    },
    "stage": {
      "enum": [
        "intake",
        "analyzed",
        "hypotheses",
        "validation"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "description",
        "accessed_at_utc",
        "original_filename",
        "references"
      ],
      "properties": {
        "source_url": {
          "$ref": "#/$defs/url"
        },
        "description": {
          "type": "string"
        },
        "accessed_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|\\+00:00)$"
        },
        "original_filename": {
          "$ref": "#/$defs/nonempty"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/url"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "encoding"
      ],
      "properties": {
        "path": {
          "const": "source/ciphertext.txt"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "encoding": {
          "const": "utf-8"
        }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "value",
        "basis"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "tentative",
            "confirmed"
          ]
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "alphabet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "symbols",
        "normalization"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unknown",
            "latin",
            "custom"
          ]
        },
        "symbols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "uniqueItems": true
        },
        "normalization": {
          "enum": [
            "none",
            "ascii_letters"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "normalization": {
                "const": "ascii_letters"
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "const": "latin"
              }
            }
          }
        }
      ]
    },
    "transcription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncertainty",
        "notes",
        "alternatives"
      ],
      "properties": {
        "uncertainty": {
          "enum": [
            "unassessed",
            "reported",
            "checked"
          ]
        },
        "notes": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "observed",
              "alternative",
              "basis"
            ],
            "properties": {
              "location": {
                "$ref": "#/$defs/nonempty"
              },
              "observed": {
                "$ref": "#/$defs/nonempty"
              },
              "alternative": {
                "$ref": "#/$defs/nonempty"
              },
              "basis": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        }
      }
    },
    "cribs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/crib"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known_plaintext_url",
        "expected_plaintext_sha256",
        "heldout_cribs"
      ],
      "properties": {
        "known_plaintext_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_plaintext_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "heldout_cribs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crib"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_plaintext_sha256": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "known_plaintext_url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://[^/\\s?#]+[^\\s]*$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "crib": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "plaintext",
        "status",
        "source_url",
        "note"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "plaintext": {
          "$ref": "#/$defs/nonempty"
        },
        "status": {
          "enum": [
            "confirmed",
            "tentative"
          ]
        },
        "source_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "source_url": {
                "$ref": "#/$defs/url"
              }
            }
          }
        }
      ]
    }
  }
}
